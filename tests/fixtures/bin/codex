#!/usr/bin/env node
import { appendFileSync, existsSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const args = process.argv.slice(2);
const scenario = process.env.FAKE_CODEX_SCENARIO ?? 'exec';
const log = process.env.FAKE_COMMAND_LOG;
if (log) appendFileSync(log, `${JSON.stringify(args)}\n`);
const environmentLog = process.env.FAKE_ENVIRONMENT_LOG;
if (environmentLog) {
  appendFileSync(environmentLog, `${JSON.stringify({
    CODEX_HOME: process.env.CODEX_HOME,
    CODEX_SQLITE_HOME: process.env.CODEX_SQLITE_HOME,
    OPENAI_API_KEY: process.env.OPENAI_API_KEY,
    CODEX_ACCESS_TOKEN: process.env.CODEX_ACCESS_TOKEN,
  })}\n`);
}

if (args[0] === 'login' && args[1] === 'status') {
  const authenticatedMarker = process.env.CODEX_HOME === undefined
    ? undefined
    : join(process.env.CODEX_HOME, '.fake-authenticated');
  if (
    scenario === 'logged-out' ||
    (scenario === 'profile-login' &&
      (authenticatedMarker === undefined || !existsSync(authenticatedMarker)))
  ) {
    process.stderr.write('Not logged in');
    process.exitCode = 1;
  } else if (scenario === 'api-key') {
    process.stderr.write('Logged in using an API key');
  } else if (scenario === 'malformed-login-status') {
    process.stderr.write('Authentication available');
  } else {
    process.stderr.write('Logged in using ChatGPT');
  }
} else if (args[0] === 'login' && scenario === 'profile-login') {
  if (process.env.CODEX_HOME === undefined) {
    process.stderr.write('CODEX_HOME is required');
    process.exitCode = 2;
  } else if (!existsSync(process.env.CODEX_HOME)) {
    process.stderr.write('CODEX_HOME must already exist');
    process.exitCode = 2;
  } else {
    writeFileSync(join(process.env.CODEX_HOME, '.fake-authenticated'), 'yes');
  }
} else if (args[0] === 'cloud' && args[1] === '--help') {
  process.stdout.write('[EXPERIMENTAL] Browse or execute Codex Cloud tasks');
} else if (args[0] === 'app-server' && args[1] === '--help') {
  if (scenario === 'app-server-missing') {
    process.stderr.write('unsupported fake codex command: app-server --help');
    process.exitCode = 2;
  } else {
    process.stdout.write('Run the Codex app server');
  }
} else if (args[0] === 'app-server' && args.includes('--stdio')) {
  const probeLog = process.env.FAKE_PROBE_CONCURRENCY_LOG;
  if (probeLog) appendFileSync(probeLog, `start:${process.pid}\n`);
  process.on('SIGTERM', () => {
    if (probeLog) appendFileSync(probeLog, `end:${process.pid}\n`);
    process.exit(0);
  });
  if (process.env.CODEX_SQLITE_HOME) {
    writeFileSync(join(process.env.CODEX_SQLITE_HOME, 'probe-state'), 'transient');
  }
  process.stdin.setEncoding('utf8');
  let input = '';
  process.stdin.on('data', (chunk) => {
    input += chunk;
    let newline = input.indexOf('\n');
    while (newline >= 0) {
      const line = input.slice(0, newline);
      input = input.slice(newline + 1);
      if (line.trim() !== '') {
        const message = JSON.parse(line);
        if (message.method === 'initialize') {
          process.stdout.write(`${JSON.stringify({ id: message.id, result: {
            userAgent: 'fake-codex',
            codexHome: process.env.CODEX_HOME,
            platformFamily: 'unix',
            platformOs: process.platform,
          } })}\n`);
        } else if (message.method === 'account/read') {
          const account = scenario === 'account-email-missing'
            ? { type: 'chatgpt', email: null, planType: 'pro' }
            : scenario === 'account-wrong-type'
              ? { type: 'apiKey' }
              : { type: 'chatgpt', email: ' Owner@Example.com ', planType: 'pro' };
          const respond = () => process.stdout.write(`${JSON.stringify({
            id: message.id,
            result: {
              account,
              requiresOpenaiAuth: scenario !== 'account-not-openai-auth',
            },
          })}\n`);
          if (scenario === 'slow-account') setTimeout(respond, 75);
          else respond();
        }
      }
      newline = input.indexOf('\n');
    }
  });
} else if (args[0] === 'cloud' && args[1] === 'exec') {
  if (scenario === 'malformed') {
    process.stdout.write('task submitted');
  } else if (scenario === 'invalid-url-host') {
    process.stdout.write('Task submitted\nhttps://chatgpt.com.example/codex/tasks/task_456');
  } else if (scenario === 'invalid-url-path') {
    process.stdout.write('Task submitted\nhttps://chatgpt.com/tasks/task_456');
  } else if (scenario === 'invalid-url-id') {
    process.stdout.write('Task submitted\nhttps://chatgpt.com/codex/tasks/not-a-task');
  } else if (scenario === 'current-cli') {
    process.stdout.write('https://chatgpt.com/codex/tasks/task_e_6a83c77cbef483309fffeee9568686bd');
  } else {
    process.stdout.write('Task submitted\nhttps://chatgpt.com/codex/tasks/task_456');
  }
} else if (args[0] === 'cloud' && args[1] === 'list') {
  const taskId = scenario === 'current-cli'
    ? 'task_e_6a83c77cbef483309fffeee9568686bd'
    : 'task_456';
  process.stdout.write(JSON.stringify({
    tasks: [
      {
        id: taskId,
        url: scenario === 'invalid-list-url'
          ? 'https://chatgpt.com/codex/tasks/task_other'
          : `https://chatgpt.com/codex/tasks/${taskId}`,
        title: 'Review auth',
        status: scenario === 'failed' ? 'failed' : 'completed',
        updated_at: '2026-08-16T12:00:00Z',
        environment_id: scenario === 'current-cli' ? null : 'env_123',
        environment_label: 'acme/web',
        summary: scenario === 'current-cli'
          ? { files_changed: 0, lines_added: 0, lines_removed: 0 }
          : 'Review complete',
        is_review: true,
        attempt_total: 1,
      },
    ],
    cursor: scenario === 'current-cli' ? 'next-page' : null,
  }));
} else if (args.length === 1 && args[0] === 'cloud') {
  process.exitCode = 0;
} else {
  process.stderr.write(`unsupported fake codex command: ${args.join(' ')}`);
  process.exitCode = 2;
}
