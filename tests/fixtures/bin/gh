#!/usr/bin/env node
import { appendFileSync } from 'node:fs';

const args = process.argv.slice(2);
const scenario = process.env.FAKE_GH_SCENARIO ?? 'project';
const log = process.env.FAKE_COMMAND_LOG;
if (log) appendFileSync(log, `${JSON.stringify(args)}\n`);

const sha = scenario === 'moved' ? 'c'.repeat(40) : 'b'.repeat(40);

function output(value) {
  process.stdout.write(JSON.stringify(value));
}

if (args[0] === 'auth' && args[1] === 'status') {
  if (scenario === 'logged-out') {
    process.stderr.write('You are not logged into any GitHub hosts.');
    process.exitCode = 1;
  }
} else if (args[0] === 'repo' && args[1] === 'view') {
  output({
    nameWithOwner: 'acme/web',
    defaultBranchRef: { name: 'main' },
    url: 'https://github.com/acme/web',
  });
} else if (args[0] === 'api') {
  if (scenario === 'error') {
    process.stderr.write('gh: forbidden (HTTP 403)');
    process.exitCode = 1;
  } else if (
    scenario === 'deleted' ||
    (scenario === 'missing' && !args[1]?.includes('heads/main')) ||
    (scenario === 'target-missing' && args[1]?.includes('-jules-'))
  ) {
    process.stderr.write('gh: Not Found (HTTP 404)');
    process.exitCode = 1;
  } else {
    output({ ref: 'refs/heads/relay/auth', object: { sha, type: 'commit' } });
  }
} else if (args[0] === 'pr' && args[1] === 'list') {
  if (scenario === 'no-pr') {
    output([]);
    process.exit();
  }
  const requestedHead = args[args.indexOf('--head') + 1] ?? 'relay/auth';
  output([
    {
      number: 143,
      url: 'https://github.com/acme/web/pull/143',
      state: 'OPEN',
      headRefName: requestedHead,
      headRefOid: sha,
      baseRefName: 'main',
      isDraft: false,
    },
  ]);
} else if (args[0] === 'pr' && args[1] === 'view') {
  const headRefName =
    scenario === 'pr-branch-mismatch'
      ? 'relay/unrelated'
      : process.env.FAKE_GH_BRANCH ?? 'relay/auth';
  output({
    number: 143,
    url: 'https://github.com/acme/web/pull/143',
    state: scenario === 'closed' ? 'CLOSED' : 'OPEN',
    headRefName,
    baseRefName: 'main',
    headRefOid: scenario === 'pr-head-mismatch' ? 'd'.repeat(40) : sha,
    isDraft: scenario === 'draft',
    mergeable: 'MERGEABLE',
    mergeStateStatus: 'CLEAN',
    reviewDecision: 'APPROVED',
    statusCheckRollup: [
      { name: 'test', status: 'COMPLETED', conclusion: 'SUCCESS' },
    ],
  });
} else if (args[0] === 'pr' && args[1] === 'checks') {
  const failing = scenario === 'failing';
  output([
    {
      name: 'test',
      state: failing ? 'FAILURE' : 'SUCCESS',
      bucket: failing ? 'fail' : 'pass',
      link: 'https://github.com/acme/web/actions/runs/1',
    },
  ]);
  if (failing) process.exitCode = 1;
} else if (args[0] === 'pr' && args[1] === 'merge') {
  process.stdout.write('merged');
} else {
  process.stderr.write(`unsupported fake gh command: ${args.join(' ')}`);
  process.exitCode = 2;
}
