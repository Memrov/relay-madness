#!/usr/bin/env node
import { appendFileSync } from 'node:fs';

const args = process.argv.slice(2);
const scenario = process.env.FAKE_GH_SCENARIO ?? 'project';
const log = process.env.FAKE_COMMAND_LOG;
if (log) appendFileSync(log, `${JSON.stringify(args)}\n`);

const sha =
  scenario === 'moved'
    ? 'c'.repeat(40)
    : scenario === 'base-a' || scenario === 'missing-base-a'
      ? 'a'.repeat(40)
      : 'b'.repeat(40);

function output(value) {
  process.stdout.write(JSON.stringify(value));
}

if (args[0] === 'auth' && args[1] === 'status') {
  if (scenario === 'logged-out') {
    process.stderr.write('You are not logged into any GitHub hosts.');
    process.exitCode = 1;
  }
} else if (args[0] === 'repo' && args[1] === 'view') {
  output({
    nameWithOwner: 'acme/web',
    defaultBranchRef: { name: 'main' },
    url: 'https://github.com/acme/web',
  });
} else if (
  args[0] === 'api' &&
  args[1]?.match(/\/commits\/[0-9a-f]{40}\/status$/i)
) {
  const requestedSha = args[1].split('/').at(-2);
  const mode = scenario.replace('commit-checks-', '');
  const state =
    mode === 'legacy-failing'
      ? 'failure'
      : mode === 'legacy-pending'
        ? 'pending'
        : mode === 'unknown'
          ? 'pending'
          : 'success';
  const statuses =
    mode === 'unknown'
      ? []
      : [
          {
            context: 'legacy/required',
            state,
            target_url: 'https://example.test/legacy-status',
          },
        ];
  output([{
    state,
    sha: requestedSha,
    total_count: statuses.length,
    statuses,
  }]);
} else if (
  args[0] === 'api' &&
  args.some(
    (argument) =>
      argument.includes('/commits/') && argument.endsWith('/check-runs'),
  )
) {
  const mode = scenario.replace('commit-checks-', '');
  if (mode === 'unknown') {
    output([{ total_count: 0, check_runs: [] }]);
  } else if (mode === 'multi-page') {
    output([
      {
        total_count: 2,
        check_runs: [
          {
            name: 'first-page',
            status: 'completed',
            conclusion: 'success',
            html_url: 'https://github.com/acme/web/actions/runs/1',
          },
        ],
      },
      {
        total_count: 2,
        check_runs: [
          {
            name: 'second-page',
            status: 'completed',
            conclusion: 'failure',
            html_url: 'https://github.com/acme/web/actions/runs/2',
          },
        ],
      },
    ]);
  } else {
    const checkRuns = [
      {
        name: 'test',
        status: mode === 'pending' ? 'in_progress' : 'completed',
        conclusion:
          mode === 'pending' ? null : mode === 'failing' ? 'failure' : 'success',
        html_url: 'https://github.com/acme/web/actions/runs/1',
      },
    ];
    if (mode === 'mixed') {
      checkRuns[0] = { ...checkRuns[0], conclusion: 'failure' };
      checkRuns.push({
        name: 'still-running',
        status: 'in_progress',
        conclusion: null,
        html_url: 'https://github.com/acme/web/actions/runs/2',
      });
    }
    output([
      {
        total_count: checkRuns.length,
        check_runs: checkRuns,
      },
    ]);
  }
} else if (
  args[0] === 'api' &&
  args[1] === 'repos/acme/web/pulls' &&
  args.includes('--method') &&
  args.includes('POST')
) {
  output({
    number: 144,
    html_url: 'https://github.com/acme/web/pull/144',
    state: 'open',
    head: { ref: 'relay/auth', sha },
    base: { ref: 'main' },
    draft: false,
  });
} else if (args[0] === 'api') {
  if (scenario === 'error') {
    process.stderr.write('gh: forbidden (HTTP 403)');
    process.exitCode = 1;
  } else if (
    scenario === 'deleted' ||
    ((scenario === 'missing' || scenario === 'missing-base-a') &&
      !args[1]?.includes('heads/main'))
  ) {
    process.stderr.write('gh: Not Found (HTTP 404)');
    process.exitCode = 1;
  } else {
    output({ ref: 'refs/heads/relay/auth', object: { sha, type: 'commit' } });
  }
} else if (args[0] === 'pr' && args[1] === 'list') {
  if (scenario === 'no-pr') {
    output([]);
    process.exit();
  }
  const requestedHead = args[args.indexOf('--head') + 1] ?? 'relay/auth';
  output([
    {
      number: 143,
      url: 'https://github.com/acme/web/pull/143',
      state: 'OPEN',
      headRefName: requestedHead,
      headRefOid: sha,
      baseRefName: 'main',
      isDraft: false,
    },
  ]);
} else if (args[0] === 'pr' && args[1] === 'view') {
  const headRefName =
    scenario === 'pr-branch-mismatch'
      ? 'relay/unrelated'
      : process.env.FAKE_GH_BRANCH ?? 'relay/auth';
  output({
    number: 143,
    url: 'https://github.com/acme/web/pull/143',
    state: scenario === 'closed' ? 'CLOSED' : 'OPEN',
    headRefName,
    baseRefName: 'main',
    headRefOid: scenario === 'pr-head-mismatch' ? 'd'.repeat(40) : sha,
    isDraft: scenario === 'draft',
    mergeable: 'MERGEABLE',
    mergeStateStatus: 'CLEAN',
    reviewDecision: 'APPROVED',
    statusCheckRollup: [
      { name: 'test', status: 'COMPLETED', conclusion: 'SUCCESS' },
    ],
  });
} else if (args[0] === 'pr' && args[1] === 'checks') {
  const failing = scenario === 'failing';
  output([
    {
      name: 'test',
      state: failing ? 'FAILURE' : 'SUCCESS',
      bucket: failing ? 'fail' : 'pass',
      link: 'https://github.com/acme/web/actions/runs/1',
    },
  ]);
  if (failing) process.exitCode = 1;
} else if (args[0] === 'pr' && args[1] === 'merge') {
  process.stdout.write('merged');
} else {
  process.stderr.write(`unsupported fake gh command: ${args.join(' ')}`);
  process.exitCode = 2;
}
