#!/usr/bin/env node
import { appendFileSync } from 'node:fs';

const args = process.argv.slice(2);
const scenario = process.env.FAKE_GH_SCENARIO ?? 'project';
const log = process.env.FAKE_COMMAND_LOG;
if (log) appendFileSync(log, `${JSON.stringify(args)}\n`);

const sha = scenario === 'moved' ? 'c'.repeat(40) : 'b'.repeat(40);

function output(value) {
  process.stdout.write(JSON.stringify(value));
}

if (args[0] === 'repo' && args[1] === 'view') {
  output({
    nameWithOwner: 'acme/web',
    defaultBranchRef: { name: 'main' },
    url: 'https://github.com/acme/web',
  });
} else if (args[0] === 'api') {
  if (scenario === 'missing') {
    process.stderr.write('gh: Not Found (HTTP 404)');
    process.exitCode = 1;
  } else {
    output({ ref: 'refs/heads/relay/auth', object: { sha, type: 'commit' } });
  }
} else if (args[0] === 'pr' && args[1] === 'list') {
  output([
    {
      number: 143,
      url: 'https://github.com/acme/web/pull/143',
      state: 'OPEN',
      headRefName: 'relay/auth',
      headRefOid: sha,
      baseRefName: 'main',
      isDraft: false,
    },
  ]);
} else if (args[0] === 'pr' && args[1] === 'view') {
  output({
    headRefOid: sha,
    isDraft: scenario === 'draft',
    mergeable: 'MERGEABLE',
    mergeStateStatus: 'CLEAN',
    reviewDecision: 'APPROVED',
    statusCheckRollup: [
      { name: 'test', status: 'COMPLETED', conclusion: 'SUCCESS' },
    ],
  });
} else if (args[0] === 'pr' && args[1] === 'checks') {
  const failing = scenario === 'failing';
  output([
    {
      name: 'test',
      state: failing ? 'FAILURE' : 'SUCCESS',
      bucket: failing ? 'fail' : 'pass',
      link: 'https://github.com/acme/web/actions/runs/1',
    },
  ]);
  if (failing) process.exitCode = 1;
} else if (args[0] === 'pr' && args[1] === 'merge') {
  process.stdout.write('merged');
} else {
  process.stderr.write(`unsupported fake gh command: ${args.join(' ')}`);
  process.exitCode = 2;
}
